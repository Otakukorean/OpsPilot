DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_COOKIES=false
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO
OPSPILOT_DEMO_PASSWORD=replace-with-a-demo-only-password
# These credentials are intentionally public in the portfolio login screen.
# Keep this account non-staff and non-admin; never reuse a real password.
OPSPILOT_TESTER_EMAIL=tester@atlaspay.example
OPSPILOT_TESTER_PASSWORD=OpsPilot-Demo-2026!

# Production-only overrides used by compose.prod.yaml. Set the public hostname
# and HTTPS origin in Dokploy without paths or trailing slashes.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
POSTGRES_CONN_MAX_AGE=60
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# P3 OpenAI/LangGraph agent. Never commit a real credential.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_CHAT_MODEL=gpt-6-luna
OPENAI_MAX_OUTPUT_TOKENS=800
AGENT_MAX_LLM_CALLS=4
AGENT_MAX_TOOL_CALLS=3
AGENT_REQUEST_TIMEOUT_SECONDS=30
AGENT_MAX_TOTAL_TOKENS=12000
AGENT_MAX_CONCURRENT_RUNS=2
AGENT_RATE_LIMIT_REQUESTS=20
AGENT_RATE_LIMIT_WINDOW_SECONDS=3600
AGENT_USER_TOKEN_BUDGET=100000
AGENT_TOKEN_BUDGET_WINDOW_SECONDS=86400

POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=replace-with-a-strong-development-password
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000

# P2 private knowledge ingestion limits. Uploaded content is synthetic-only.
OPSPILOT_PRIVATE_MEDIA_ROOT=/app/private_media
KNOWLEDGE_MAX_UPLOAD_BYTES=10485760
KNOWLEDGE_MAX_PDF_PAGES=100
KNOWLEDGE_EMBEDDING_PROVIDER=local_hashing_v1
KNOWLEDGE_MIN_SIMILARITY=0.15
